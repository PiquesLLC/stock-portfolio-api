DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
NODE_ENV=
# 3001 — must match the UI dev proxy (stock-portfolio-ui/vite.config.ts)
PORT=3001
READ_ONLY=
BILLING_ENABLED=
ALLOWED_ORIGINS=

FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
AV_DAILY_LIMIT=
PERPLEXITY_API_KEY=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=

MFA_ENCRYPTION_KEY=
RESEND_API_KEY=

# OAuth sign-in (token verification)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# App Store Server API credentials (In-App Purchase key).
# Generated separately in App Store Connect -> Users and Access -> Integrations
# -> In-App Purchase. Apple does NOT allow this key to be shared with other
# Apple services, and the generic APPLE_KEY_ID / APPLE_TEAM_ID /
# APPLE_PRIVATE_KEY above belong to OAuth sign-in and are also used as APNs
# fallbacks — putting the IAP key there would make push notifications sign with
# the wrong key.
# Bundle id of the iOS app. Required by the App Store Server API token AND by
# JWS verification. Shared with APNs.
APPLE_BUNDLE_ID=

APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=

# Apple reconciliation worker runtime. Deliberately SEPARATE from
# APPLE_IAP_ENABLED so exercising the worker never means turning
# customer-facing Apple IAP on. Both remain false for now.
APPLE_RECONCILIATION_WORKER_ENABLED=false

# Controlled Sandbox entitlement projection (QA only).
#
# Sandbox purchases always bind, reconcile and audit. By DEFAULT they never
# touch User.plan — without this hatch, Production would be the first
# environment where the complete purchase -> plan -> unlock path ever runs.
#
# Projection of Sandbox facts requires ALL of:
#   1. the AUTHORITATIVE Apple environment is Sandbox
#   2. APPLE_SANDBOX_PROJECTION_ENABLED is exactly the string 'true'
#   3. the subscription is already bound to a User (the allowlist is permission
#      to PROJECT, never permission to CLAIM a subscription)
#   4. that exact User.id appears in APPLE_SANDBOX_PROJECTION_USER_IDS
#
# Anything else fails CLOSED. There is no NODE_ENV shortcut (TestFlight talks
# to the real production backend), no header/body/email/token opt-in, and no
# "all Sandbox users" mode. An empty or missing allowlist means NOBODY.
#
# Turning the flag off stops future Sandbox projection. It does NOT revert a
# plan already granted — cleaning up disposable QA accounts is an explicit
# later operation.
APPLE_SANDBOX_PROJECTION_ENABLED=false

# Comma-separated server-side User UUIDs. Empty = nobody. Never emails,
# usernames, appAccountTokens or originalTransactionIds.
APPLE_SANDBOX_PROJECTION_USER_IDS=

# Apple IAP (StoreKit 2) — numeric App Store app ID; required to verify
# production App Store Server Notifications
APPLE_APP_APPLE_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_RETURN_URL=

PRICE_CACHE_TTL=
SNAPSHOT_INTERVAL_SECONDS=
QUOTE_CACHE_TTL_SECONDS=
REPRICE_THRESHOLD_SECONDS=
QUOTE_REFRESH_INTERVAL_MS=
MAX_REFRESH_TICKERS=
SP500_CAGR_TOTAL_RETURN=
RISK_FREE_RATE=
JWT_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN_DAYS=

AI_PREMIUM_ENABLED=
CLEANUP_MIGRATED_HOLDINGS=
EMAIL_VERIFICATION_ENABLED=false
