PORT=3001
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# JWT Authentication (required - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=

# Polygon API (required for live quotes)
POLYGON_API_KEY=
QUOTE_CACHE_TTL_SECONDS=30
REPRICE_THRESHOLD_SECONDS=30

# Finnhub API (optional)
FINNHUB_API_KEY=
PRICE_CACHE_TTL=5
SNAPSHOT_INTERVAL_SECONDS=60

# Alpha Vantage (optional - for fundamentals/economic data)
ALPHA_VANTAGE_API_KEY=

# Perplexity AI (optional - for AI features)
PERPLEXITY_API_KEY=

# CORS (comma-separated origins, auto-includes localhost in dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Railway production example:
# DATABASE_URL="file:/data/nala.db"
# NODE_ENV=production
# ALLOWED_ORIGINS=https://your-app.up.railway.app
