{
    "name": "stock-portfolio-api",
    "version": "0.1.0-beta",
    "description": "Robinhood-style REST API for real-time stock portfolio tracking with momentum-based projection engine",
    "main": "dist/index.js",
    "scripts": {
        "build": "prisma generate && tsc",
        "start": "prisma migrate deploy && node dist/index.js",
        "dev": "node scripts/kill-port.js && nodemon --exec ts-node src/index.ts",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:seed": "npx prisma db seed",
        "check:env": "node scripts/check-env.js",
        "smoke:test": "node scripts/smoke-test.js",
        "lint": "eslint src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "prisma": {
        "seed": "npx ts-node prisma/seed.ts"
    },
    "engines": {
        "node": ">=20"
    },
    "jest": {
        "roots": [
            "<rootDir>/src"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/dist/",
            "/.claude/"
        ],
        "modulePathIgnorePatterns": [
            "/dist/",
            "/.claude/"
        ],
        "moduleFileExtensions": [
            "ts",
            "js",
            "json"
        ],
        "testMatch": [
            "<rootDir>/src/__tests__/**/*.test.ts"
        ]
    },
    "dependencies": {
        "@prisma/client": "^5.7.0",
        "@sentry/node": "^10.46.0",
        "@types/qrcode": "^1.5.6",
        "apple-signin-auth": "^2.0.0",
        "axios": "^1.14.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csv-parse": "^6.2.1",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "node-cache": "^5.1.2",
        "otpauth": "^9.5.0",
        "plaid": "^41.4.0",
        "prisma": "^5.22.0",
        "qrcode": "^1.5.4",
        "resend": "^6.9.4",
        "sharp": "^0.34.5",
        "stripe": "^20.3.1",
        "tesseract.js": "^7.0.0",
        "typescript": "^5.9.3",
        "web-push": "^3.6.7",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^20.10.5",
        "@types/supertest": "^6.0.3",
        "@types/web-push": "^3.6.4",
        "@typescript-eslint/eslint-plugin": "^8.57.2",
        "@typescript-eslint/parser": "^8.56.0",
        "@vitest/coverage-v8": "^4.1.2",
        "cross-env": "^10.1.0",
        "eslint": "^10.1.0",
        "nodemon": "^3.0.2",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "vitest": "^4.0.18"
    }
}
