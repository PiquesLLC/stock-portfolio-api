{
    "name": "stock-portfolio-api",
    "version": "0.1.0-beta",
    "description": "Robinhood-style REST API for real-time stock portfolio tracking with momentum-based projection engine",
    "main": "dist/index.js",
    "scripts": {
        "build": "prisma generate && prisma generate --config=./prisma-v2/prisma.config.ts && tsc",
        "start": "prisma migrate deploy && node dist/index.js",
        "dev": "node scripts/ensure-dev-db.js && node scripts/kill-port.js && nodemon",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:seed": "npx prisma db seed",
        "prisma:v2:generate": "prisma generate --config=./prisma-v2/prisma.config.ts",
        "prisma:v2:migrate:dev": "prisma migrate dev --config=./prisma-v2/prisma.config.ts",
        "prisma:v2:migrate:deploy": "prisma migrate deploy --config=./prisma-v2/prisma.config.ts",
        "prisma:v2:migrate:reset": "prisma migrate reset --config=./prisma-v2/prisma.config.ts",
        "prisma:v2:studio": "prisma studio --config=./prisma-v2/prisma.config.ts",
        "prisma:v2:seed": "npx ts-node prisma-v2/seed.ts",
        "v2:dev:up": "docker compose up -d postgres-v2",
        "v2:dev:down": "docker compose down",
        "v2:dev:reset": "docker compose down -v && docker compose up -d postgres-v2",
        "check:env": "node scripts/check-env.js",
        "smoke:test": "node scripts/smoke-test.js",
        "smoke:test:prod": "cross-env SMOKE_BASE_URL=https://stock-portfolio-api-production.up.railway.app node scripts/smoke-test.js",
        "smoke:email": "node scripts/smoke-email-verification.js",
        "lint": "eslint src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:v2:integration": "cross-env RUN_V2_INTEGRATION=1 V2_DATABASE_URL=postgresql://nala_v2:dev_password_local_only@localhost:5432/nala_v2_ledger vitest run src/v2/ledger/__tests__/integration",
        "apple:requeue-parked": "npx ts-node scripts/apple-requeue-parked.ts"
    },
    "prisma": {
        "seed": "npx ts-node prisma/seed.ts"
    },
    "engines": {
        "node": ">=22.12"
    },
    "jest": {
        "roots": [
            "<rootDir>/src"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/dist/",
            "/.claude/"
        ],
        "modulePathIgnorePatterns": [
            "/dist/",
            "/.claude/"
        ],
        "moduleFileExtensions": [
            "ts",
            "js",
            "json"
        ],
        "testMatch": [
            "<rootDir>/src/__tests__/**/*.test.ts"
        ]
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.111.0",
        "@apple/app-store-server-library": "^3.1.0",
        "@aws-sdk/client-s3": "^3.1057.0",
        "@prisma/adapter-libsql": "^7.4.2",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.4.2",
        "@sentry/node": "^10.39.0",
        "@types/qrcode": "^1.5.6",
        "apple-signin-auth": "^2.0.0",
        "axios": "^1.19.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csv-parse": "^6.1.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "jose": "^5.10.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.0.2",
        "node-cache": "^5.1.2",
        "otpauth": "^9.5.0",
        "pg": "^8.21.0",
        "plaid": "^41.1.0",
        "prisma": "^7.4.2",
        "qrcode": "^1.5.4",
        "resend": "^6.9.2",
        "sharp": "^0.34.5",
        "stripe": "^20.3.1",
        "tesseract.js": "^7.0.0",
        "typescript": "^5.9.3",
        "web-push": "^3.6.7",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.10.5",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^6.0.3",
        "@types/web-push": "^3.6.4",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "@vitest/coverage-v8": "^4.0.18",
        "cross-env": "^10.1.0",
        "eslint": "^10.0.0",
        "nodemon": "^3.0.2",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "vitest": "^4.0.18"
    }
}
