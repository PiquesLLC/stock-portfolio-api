generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Holding {
  id          String   @id @default(uuid())
  ticker      String
  shares      Float
  averageCost Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  @@unique([userId, ticker])
}

model PortfolioSnapshot {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  totalValue     Float
  cashBalance    Float
  dailyPL        Float
  dailyPLPercent Float
  totalPL        Float
  totalPLPercent Float
  netEquity      Float?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId, timestamp])
}

model User {
  id                    String              @id @default(uuid())
  username              String              @unique
  displayName           String
  createdAt             DateTime            @default(now())
  trackingActive        Boolean             @default(false)
  trackingStartAt       DateTime?
  leaderboardEligible   Boolean             @default(false)
  leaderboardEligibleAt DateTime?
  profilePublic         Boolean             @default(true)
  region                String?
  showRegion            Boolean             @default(true)
  holdingsVisibility    String              @default("all") // 'all' | 'top5' | 'sectors' | 'hidden'
  holdings              Holding[]
  snapshots             PortfolioSnapshot[]
  settings              UserSettings?
  followers             Follow[]            @relation("following")
  following             Follow[]            @relation("follower")
  activityEvents        ActivityEvent[]
  transactions          Transaction[]
  alerts                Alert[]
}

model UserSettings {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  cashBalance Float    @default(0)
  marginDebt  Float    @default(0)
  updatedAt   DateTime @updatedAt
}

model Settings {
  id          String   @id @default("default")
  cashBalance Float    @default(0)
  marginDebt  Float    @default(0)
  updatedAt   DateTime @updatedAt

  // Baseline tracking for performance measurement
  trackingStartDate   DateTime?
  baselineTotalValue  Float?
  baselineCashBalance Float?
  baselineType        String?   // 'fresh_start' | 'existing_portfolio'

  // Optional broker lifetime stats (user-provided, display-only)
  brokerLifetimeDeposits    Float?
  brokerLifetimeWithdrawals Float?
  brokerLifetimeValue       Float?
  brokerLifetimeAsOf        DateTime?

  // Optional YTD tracking (user-provided for True YTD calculation)
  ytdStartEquity      Float?    // Net equity on Jan 1
  ytdNetContributions  Float?    // Deposits - withdrawals since Jan 1
}

model HoldingSnapshot {
  id           String   @id @default(uuid())
  snapshotId   String
  ticker       String
  shares       Float
  price        Float
  marketValue  Float
  dayPL        Float
  dayPLPercent Float
  timestamp    DateTime @default(now())

  @@index([ticker, timestamp])
  @@index([snapshotId])
}

model DividendEvent {
  id        String   @id @default(uuid())
  ticker    String
  amount    Float
  date      DateTime
  createdAt DateTime @default(now())

  @@index([date])
  @@index([ticker])
}

model Goal {
  id                  String    @id @default(uuid())
  name                String
  targetValue         Float
  monthlyContribution Float     @default(0)
  deadline            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ActivityEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'holding_added' | 'holding_removed' | 'holding_updated'
  payload   String   // JSON string with event details
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String?
  type      String   // 'deposit' | 'withdrawal'
  amount    Float
  date      DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model Alert {
  id        String       @id @default(uuid())
  userId    String?
  type      String       // 'drawdown' | 'sector_exposure' | 'underperform_spy' | 'drag' | '52w_high' | '52w_low'
  threshold Float?
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  user      User?        @relation(fields: [userId], references: [id])
  events    AlertEvent[]

  @@index([userId])
}

model AlertEvent {
  id        String   @id @default(uuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id])
  message   String
  data      String?  // JSON
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
}

model LeaderboardCache {
  id         String   @id @default(uuid())
  userId     String
  window     String   // '1D' | '1W' | '1M' | 'YTD' | '1Y'
  twrPct     Float?
  flagged    Boolean  @default(false)
  flagReason String?
  isNew      Boolean  @default(false)
  computedAt DateTime @default(now())

  @@unique([userId, window])
  @@index([window, twrPct])
}
