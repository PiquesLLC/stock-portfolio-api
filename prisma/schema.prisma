generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Portfolio {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String    @default("general")
  isDefault   Boolean   @default(false)
  cashBalance Float     @default(0)
  marginDebt  Float     @default(0)
  dripEnabled Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  holdings    Holding[]

  @@unique([userId, name])
  @@index([userId])
}

model Holding {
  id               String     @id @default(uuid())
  ticker           String
  shares           Float
  averageCost      Float
  source           String?    @default("manual")
  holdingType      String     @default("equity") // "equity" | "option"
  optionUnderlying String?    // e.g., "AAPL"
  optionStrike     Float?     // e.g., 230.00
  optionExpiry     String?    // e.g., "2026-03-20"
  optionType       String?    // "call" | "put"
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  userId           String?
  user             User?      @relation(fields: [userId], references: [id])
  portfolioId      String?
  portfolio        Portfolio?  @relation(fields: [portfolioId], references: [id])

  @@unique([portfolioId, ticker])
  @@index([userId])
}

model PortfolioSnapshot {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  totalValue     Float
  cashBalance    Float
  dailyPL        Float
  dailyPLPercent Float
  totalPL        Float
  totalPLPercent Float
  netEquity      Float?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId, timestamp])
}

model PortfolioCompositionChange {
  id        String   @id @default(uuid())
  userId    String
  reason    String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
}

model User {
  id                     String                 @id @default(uuid())
  username               String                 @unique
  displayName            String
  passwordHash           String?
  failedLoginAttempts    Int                    @default(0)
  lockedUntil            DateTime?
  plan                   String                 @default("free")
  stripeCustomerId       String?                @unique
  stripeSubscriptionId   String?
  planExpiresAt          DateTime?
  planStartedAt          DateTime?
  createdAt              DateTime               @default(now())
  trackingActive         Boolean                @default(false)
  trackingStartAt        DateTime?
  leaderboardEligible    Boolean                @default(false)
  leaderboardEligibleAt  DateTime?
  profilePublic          Boolean                @default(true)
  region                 String?
  showRegion             Boolean                @default(true)
  timezone               String?                // IANA timezone name (e.g., "America/New_York"); null = default to ET

  holdingsVisibility     String                 @default("all") // 'all' | 'top5' | 'sectors' | 'hidden'
  bio                    String?
  email                  String?                @unique
  emailVerified          Boolean                @default(false)
  googleId               String?                @unique
  appleId                String?                @unique
  avatarUrl              String?
  holdings               Holding[]
  portfolios             Portfolio[]
  snapshots              PortfolioSnapshot[]
  settings               UserSettings?
  followers              Follow[]               @relation("following")
  following              Follow[]               @relation("follower")
  activityEvents         ActivityEvent[]
  compositionChanges     PortfolioCompositionChange[]
  transactions           Transaction[]
  alerts                 Alert[]
  watchlists             Watchlist[]
  dividendCredits        DividendCredit[]
  lots                   Lot[]
  dividendReinvestments  DividendReinvestment[]
  refreshTokens          RefreshToken[]
  usernameChanges        UsernameChangeAudit[]
  notificationAuditLogs  NotificationAuditLog[]
  consentRecords         ConsentRecord[]
  mfaMethods             MfaMethod[]
  mfaChallenges          MfaChallenge[]
  mfaBackupCodes         MfaBackupCode[]
  emailOtpCodes          EmailOtpCode[]
  leaderboardCaches      LeaderboardCache[]
  priceAlerts            PriceAlert[]
  stockFollows           StockFollow[]
  milestoneEvents        MilestoneEvent[]
  anomalyEvents          AnomalyEvent[]
  plaidItems             PlaidItem[]
  goals                  Goal[]

  // Referral tracking
  referredBy             String?
  referrer               User?                  @relation("referrals", fields: [referredBy], references: [id])
  referrals              User[]                 @relation("referrals")
  referralsGiven         Referral[]             @relation("referrer")
  referralsReceived      Referral[]             @relation("referred")

  // Creator monetization relations
  creator                Creator?
  creatorSubscriptions   CreatorSubscription[]   @relation("subscriber")
  creatorSubscribedTo    CreatorSubscription[]   @relation("creator_sub")
  creatorReports         CreatorReport[]

  // UGC reporting
  reportsSubmitted       UserReport[]            @relation("ReportsSubmitted")
  reportsReceived        UserReport[]            @relation("ReportsReceived")

  // Portfolio trade history (from CSV import)
  portfolioTrades        PortfolioTrade[]

  // Ledger events (cash/non-trade account events from CSV import)
  ledgerEvents           LedgerEvent[]

  // NALA AI Deep Research jobs
  deepResearchJobs       DeepResearchJob[]

  // Push notification subscriptions
  pushSubscriptions      PushSubscription[]
  devicePushTokens       DevicePushToken[]

  // Apple IAP
  appleOriginalTransactionId  String?   @unique
  applePurchaseSource         String?   // 'app_store'

  // Dismissed dividends (user opted out of YTD entries they didn't actually receive)
  dismissedDividends         DismissedDividend[]

  // Verified performance profile (Phase 2)
  kycVerified                Boolean                @default(false)
  kycVerifiedAt              DateTime?
  performanceBadges          PerformanceBadge[]
  profileStatsCache          ProfileStatsCache?

  // Social engagement (Phase 3)
  posts                      Post[]
  comments                   Comment[]
  likes                      Like[]
  socialNotifsReceived       SocialNotification[]   @relation("socialNotifRecipient")
  socialNotifsActed          SocialNotification[]   @relation("socialNotifActor")

  // Content moderation
  suspended                  Boolean                @default(false)
  suspendedAt                DateTime?
  contentStrikes             ContentStrike[]
  appeals                    Appeal[]

  // User blocking
  blocksGiven                UserBlock[]             @relation("blockerBlocks")
  blocksReceived             UserBlock[]             @relation("blockedBlocks")
}

model Watchlist {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#00C805")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  holdings    WatchlistHolding[]

  @@unique([userId, name])
}

model WatchlistHolding {
  id          String    @id @default(uuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  ticker      String
  shares      Float
  averageCost Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([watchlistId, ticker])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  family    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([family])
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model UsernameChangeAudit {
  id          String   @id @default(uuid())
  userId      String
  oldUsername String
  newUsername String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([newUsername])
}

model ConsentRecord {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyVersion String
  consentedAt   DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@unique([userId, policyVersion])
  @@index([userId])
}

model MfaMethod {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String    // 'totp' | 'email'
  secretCiphertext String?   // AES-256-GCM encrypted TOTP secret (null for email type)
  enabled          Boolean   @default(false)
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model MfaChallenge {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model MfaBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailOtpCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  cashBalance Float    @default(0)
  marginDebt  Float    @default(0)
  dripEnabled Boolean  @default(false)
  cashInterestRate Float @default(0)
  ytdBaselineValue Float?
  updatedAt   DateTime @updatedAt

  // Baseline tracking for performance measurement (per-user)
  trackingStartDate   DateTime?
  baselineTotalValue  Float?
  baselineCashBalance Float?
  baselineType        String?   // 'fresh_start' | 'existing_portfolio'

  // Optional broker lifetime stats (user-provided, display-only)
  brokerLifetimeDeposits    Float?
  brokerLifetimeWithdrawals Float?
  brokerLifetimeValue       Float?
  brokerLifetimeAsOf        DateTime?

  // Optional YTD tracking (user-provided for True YTD calculation)
  ytdStartEquity       Float?
  ytdNetContributions   Float?

  // Per-user analyst event read tracking
  analystLastReadAt    DateTime?

  // Annual salary for income coverage calculations
  annualSalary         Float?

  // Anomaly detection thresholds (user-configurable)
  priceSpikePct        Float    @default(3.0)
}

model Settings {
  id          String   @id @default("default")
  cashBalance Float    @default(0)
  marginDebt  Float    @default(0)
  cashInterestRate Float @default(0)
  updatedAt   DateTime @updatedAt

  // Baseline tracking for performance measurement
  trackingStartDate   DateTime?
  baselineTotalValue  Float?
  baselineCashBalance Float?
  baselineType        String?   // 'fresh_start' | 'existing_portfolio'

  // Optional broker lifetime stats (user-provided, display-only)
  brokerLifetimeDeposits    Float?
  brokerLifetimeWithdrawals Float?
  brokerLifetimeValue       Float?
  brokerLifetimeAsOf        DateTime?

  // Optional YTD tracking (user-provided for True YTD calculation)
  ytdStartEquity      Float?    // Net equity on Jan 1
  ytdNetContributions  Float?    // Deposits - withdrawals since Jan 1

  // Dividend Reinvestment Plan (DRIP) settings
  dripEnabled Boolean @default(false)
}

model NotificationAuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  status    String
  channel   String?
  title     String?
  message   String?
  refKey    String?
  payload   String?
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type, sentAt])
  @@unique([userId, type, refKey])
}

model HoldingSnapshot {
  id           String   @id @default(uuid())
  snapshotId   String
  ticker       String
  shares       Float
  price        Float
  marketValue  Float
  dayPL        Float
  dayPLPercent Float
  timestamp    DateTime @default(now())

  @@index([ticker, timestamp])
  @@index([snapshotId])
}

model DividendEvent {
  id              String           @id @default(uuid())
  ticker          String
  exDate          DateTime
  recordDate      DateTime?
  payDate         DateTime
  amountPerShare  Float
  currency        String           @default("USD")
  dividendType    String           @default("regular")
  source          String           @default("yahoo")
  status          String           @default("confirmed")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  credits         DividendCredit[]

  dismissals      DismissedDividend[]

  @@unique([ticker, exDate, amountPerShare])
  @@index([ticker])
  @@index([payDate])
  @@index([exDate])
}

model DividendCredit {
  id              String                 @id @default(uuid())
  userId          String?
  ticker          String
  dividendEventId String
  dividendEvent   DividendEvent          @relation(fields: [dividendEventId], references: [id])
  sharesEligible  Float
  amountGross     Float
  currency        String                 @default("USD")
  creditedAt      DateTime
  status          String                 @default("posted")
  createdAt       DateTime               @default(now())
  user            User?                  @relation(fields: [userId], references: [id])
  reinvestment    DividendReinvestment?

  @@unique([userId, dividendEventId])
  @@index([userId])
  @@index([ticker])
}

model DividendReinvestment {
  id               String         @id @default(uuid())
  userId           String?
  dividendCreditId String         @unique
  dividendCredit   DividendCredit @relation(fields: [dividendCreditId], references: [id])
  ticker           String
  sharesPurchased  Float
  pricePerShare    Float
  totalAmount      Float
  fillDate         DateTime
  status           String         @default("completed")
  createdAt        DateTime       @default(now())
  user             User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([ticker])
}

model Lot {
  id            String   @id @default(uuid())
  userId        String?
  ticker        String
  shares        Float
  costPerShare  Float
  totalCost     Float
  acquiredAt    DateTime
  source        String   @default("manual")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id])

  @@index([userId, ticker])
  @@index([ticker])
}

model Goal {
  id                  String    @id @default(uuid())
  userId              String
  name                String
  targetValue         Float
  currentValue        Float?
  monthlyContribution Float     @default(0)
  deadline            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model StockFollow {
  id        String   @id @default(uuid())
  userId    String
  symbol    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([symbol])
  @@index([userId])
}

model ActivityEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'holding_added' | 'holding_removed' | 'holding_updated'
  payload   String   // JSON string with event details
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String?
  type      String   // 'deposit' | 'withdrawal'
  amount    Float
  date      DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model Alert {
  id        String       @id @default(uuid())
  userId    String?
  type      String       // 'drawdown' | 'sector_exposure' | 'underperform_spy' | 'drag' | '52w_high' | '52w_low'
  threshold Float?
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  user      User?        @relation(fields: [userId], references: [id])
  events    AlertEvent[]

  @@index([userId])
}

model AlertEvent {
  id        String   @id @default(uuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id])
  message   String
  data      String?  // JSON
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
}

model LeaderboardCache {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  window     String   // '1D' | '1W' | '1M' | 'YTD' | '1Y'
  twrPct     Float?
  flagged    Boolean  @default(false)
  flagReason String?
  isNew      Boolean  @default(false)
  computedAt DateTime @default(now())

  @@unique([userId, window])
  @@index([window, twrPct])
}

model PriceAlert {
  id                 String            @id @default(uuid())
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker             String
  condition          String            // 'above' | 'below' | 'pct_up' | 'pct_down'
  targetPrice        Float?            // For above/below
  percentChange      Float?            // For pct_up/pct_down
  referencePrice     Float?            // Price when created (for % alerts)
  referencePriceType String?           // 'current' | 'open' | 'avgCost'
  repeatAlert        Boolean           @default(false)
  expiresAt          DateTime?
  enabled            Boolean           @default(true)
  triggered          Boolean           @default(false)
  triggeredAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  events             PriceAlertEvent[]

  @@index([ticker])
  @@index([enabled, triggered])
}

model PriceAlertEvent {
  id           String     @id @default(uuid())
  priceAlertId String
  priceAlert   PriceAlert @relation(fields: [priceAlertId], references: [id], onDelete: Cascade)
  triggerPrice Float
  message      String
  read         Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([priceAlertId])
}

// Analyst price target and rating tracking
model AnalystSnapshot {
  id              String   @id @default(uuid())
  ticker          String   @unique
  targetHigh      Float?
  targetLow       Float?
  targetMean      Float?
  targetMedian    Float?
  strongBuy       Int?
  buy             Int?
  hold            Int?
  sell            Int?
  strongSell      Int?
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([ticker])
}

model AnalystEvent {
  id          String   @id @default(uuid())
  ticker      String
  eventType   String   // 'target_change' | 'rating_change'
  message     String
  oldValue    String?  // JSON string of old data
  newValue    String?  // JSON string of new data
  changePct   Float?   // For target changes
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([ticker])
  @@index([read])
  @@index([createdAt])
}

// Alpha Vantage fundamentals cache — one row per ticker, stores parsed JSON
model FundamentalsCache {
  id              String   @id @default(uuid())
  ticker          String   @unique
  overviewJson    String?
  incomeJson      String?
  balanceJson     String?
  cashFlowJson    String?
  earningsJson    String?
  lastFetchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ticker])
  @@index([lastFetchedAt])
}

// Economic indicator cache — one row per indicator type
model EconomicIndicatorCache {
  id              String   @id @default(uuid())
  indicator       String   @unique
  name            String
  unit            String
  latestValue     Float?
  latestDate      String?
  historyJson     String   @default("[]")
  lastFetchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([indicator])
}

// Track Alpha Vantage daily API usage for budget management
model AVDailyUsage {
  id          String   @id @default(uuid())
  date        String   @unique
  callCount   Int      @default(0)
  tickers     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Milestone events for 52-week and all-time high/low alerts
model MilestoneEvent {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker        String
  eventType     String   // '52w_high' | '52w_low' | 'ath' | 'atl'
  message       String
  currentPrice  Float
  thresholdPrice Float   // The 52w high/low or ATH/ATL price
  isNewRecord   Boolean  @default(false) // True if it's a NEW high/low, not just at the level
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([ticker])
  @@index([read])
  @@index([createdAt])
}

model AnomalyEvent {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker      String
  type        String   // volume_spike, price_spike, drawdown, sector_divergence, concentration
  severity    String   // info, warning, critical
  title       String
  description String
  analysis    String?
  citations   String?
  value       Float?
  threshold   Float?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([ticker, createdAt])
  @@index([read, createdAt])
}

// Plaid Link items — access tokens encrypted at rest via AES-256-GCM
model PlaidItem {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId       String   @unique  // Plaid's item_id
  accessTokenEnc    String             // AES-256-GCM encrypted access_token (iv:ciphertext:tag)
  institutionId     String?
  institutionName   String?
  consentExpiresAt  DateTime?
  status            String   @default("active") // active | suspended | revoked | error
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  plaidAccounts     PlaidAccount[]

  @@index([userId])
}

// Plaid accounts linked to a PlaidItem
model PlaidAccount {
  id              String    @id @default(uuid())
  plaidItemId     String
  plaidItem       PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  plaidAccountId  String    @unique  // Plaid's account_id
  name            String?
  officialName    String?
  type            String?   // depository, investment, credit, loan
  subtype         String?   // checking, savings, 401k, etc.
  mask            String?   // Last 4 digits
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([plaidItemId])
}

// Stripe webhook idempotency records
model BillingWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ─── Creator Monetization Marketplace ───────────────────────────────

model Creator {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               String             @default("pending") // pending | active | suspended
  pitch                String?            // Creator's pitch text shown to potential subscribers
  pricingCents         Int                @default(500) // 500 | 1500 | 4900
  trialDays            Int                @default(0) // 0 | 7
  stripeConnectId      String?            // Stripe Connect account ID
  stripeConnectOnboarded Boolean          @default(false)
  complianceAcceptedAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  visibility           CreatorVisibility?

  @@index([status])
}

model CreatorVisibility {
  id               String  @id @default(uuid())
  creatorId        String  @unique
  creator          Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  showHoldings     Boolean @default(false)
  showTradeHistory Boolean @default(false)
  showRationale    Boolean @default(false)
  showSectors      Boolean @default(false)
  showRiskMetrics  Boolean @default(false)
  showWatchlists   Boolean @default(false)
  tradeDelayHours  Int     @default(24) // 24 | 48 | 72 (SEC: 0 not allowed)
