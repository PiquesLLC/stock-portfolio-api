generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Holding {
  id          String   @id @default(uuid())
  ticker      String
  shares      Float
  averageCost Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  @@unique([userId, ticker])
}

model PortfolioSnapshot {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  totalValue     Float
  cashBalance    Float
  dailyPL        Float
  dailyPLPercent Float
  totalPL        Float
  totalPLPercent Float
  netEquity      Float?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId, timestamp])
}

model User {
  id                     String                 @id @default(uuid())
  username               String                 @unique
  displayName            String
  passwordHash           String?
  createdAt              DateTime               @default(now())
  trackingActive         Boolean                @default(false)
  trackingStartAt        DateTime?
  leaderboardEligible    Boolean                @default(false)
  leaderboardEligibleAt  DateTime?
  profilePublic          Boolean                @default(true)
  region                 String?
  showRegion             Boolean                @default(true)
  holdingsVisibility     String                 @default("all") // 'all' | 'top5' | 'sectors' | 'hidden'
  bio                    String?
  holdings               Holding[]
  snapshots              PortfolioSnapshot[]
  settings               UserSettings?
  followers              Follow[]               @relation("following")
  following              Follow[]               @relation("follower")
  activityEvents         ActivityEvent[]
  transactions           Transaction[]
  alerts                 Alert[]
  dividendCredits        DividendCredit[]
  lots                   Lot[]
  dividendReinvestments  DividendReinvestment[]
  refreshTokens          RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model UserSettings {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  cashBalance Float    @default(0)
  marginDebt  Float    @default(0)
  dripEnabled Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Settings {
  id          String   @id @default("default")
  cashBalance Float    @default(0)
  marginDebt  Float    @default(0)
  updatedAt   DateTime @updatedAt

  // Baseline tracking for performance measurement
  trackingStartDate   DateTime?
  baselineTotalValue  Float?
  baselineCashBalance Float?
  baselineType        String?   // 'fresh_start' | 'existing_portfolio'

  // Optional broker lifetime stats (user-provided, display-only)
  brokerLifetimeDeposits    Float?
  brokerLifetimeWithdrawals Float?
  brokerLifetimeValue       Float?
  brokerLifetimeAsOf        DateTime?

  // Optional YTD tracking (user-provided for True YTD calculation)
  ytdStartEquity      Float?    // Net equity on Jan 1
  ytdNetContributions  Float?    // Deposits - withdrawals since Jan 1

  // Dividend Reinvestment Plan (DRIP) settings
  dripEnabled Boolean @default(false)
}

model HoldingSnapshot {
  id           String   @id @default(uuid())
  snapshotId   String
  ticker       String
  shares       Float
  price        Float
  marketValue  Float
  dayPL        Float
  dayPLPercent Float
  timestamp    DateTime @default(now())

  @@index([ticker, timestamp])
  @@index([snapshotId])
}

model DividendEvent {
  id              String           @id @default(uuid())
  ticker          String
  exDate          DateTime
  recordDate      DateTime?
  payDate         DateTime
  amountPerShare  Float
  currency        String           @default("USD")
  dividendType    String           @default("regular")
  source          String           @default("yahoo")
  status          String           @default("confirmed")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  credits         DividendCredit[]

  @@unique([ticker, exDate, amountPerShare])
  @@index([ticker])
  @@index([payDate])
  @@index([exDate])
}

model DividendCredit {
  id              String                 @id @default(uuid())
  userId          String?
  ticker          String
  dividendEventId String
  dividendEvent   DividendEvent          @relation(fields: [dividendEventId], references: [id])
  sharesEligible  Float
  amountGross     Float
  currency        String                 @default("USD")
  creditedAt      DateTime
  status          String                 @default("posted")
  createdAt       DateTime               @default(now())
  user            User?                  @relation(fields: [userId], references: [id])
  reinvestment    DividendReinvestment?

  @@unique([userId, dividendEventId])
  @@index([userId])
  @@index([ticker])
}

model DividendReinvestment {
  id               String         @id @default(uuid())
  userId           String?
  dividendCreditId String         @unique
  dividendCredit   DividendCredit @relation(fields: [dividendCreditId], references: [id])
  ticker           String
  sharesPurchased  Float
  pricePerShare    Float
  totalAmount      Float
  fillDate         DateTime
  status           String         @default("completed")
  createdAt        DateTime       @default(now())
  user             User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([ticker])
}

model Lot {
  id            String   @id @default(uuid())
  userId        String?
  ticker        String
  shares        Float
  costPerShare  Float
  totalCost     Float
  acquiredAt    DateTime
  source        String   @default("manual")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id])

  @@index([userId, ticker])
  @@index([ticker])
}

model Goal {
  id                  String    @id @default(uuid())
  name                String
  targetValue         Float
  monthlyContribution Float     @default(0)
  deadline            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ActivityEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'holding_added' | 'holding_removed' | 'holding_updated'
  payload   String   // JSON string with event details
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String?
  type      String   // 'deposit' | 'withdrawal'
  amount    Float
  date      DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model Alert {
  id        String       @id @default(uuid())
  userId    String?
  type      String       // 'drawdown' | 'sector_exposure' | 'underperform_spy' | 'drag' | '52w_high' | '52w_low'
  threshold Float?
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  user      User?        @relation(fields: [userId], references: [id])
  events    AlertEvent[]

  @@index([userId])
}

model AlertEvent {
  id        String   @id @default(uuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id])
  message   String
  data      String?  // JSON
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
}

model LeaderboardCache {
  id         String   @id @default(uuid())
  userId     String
  window     String   // '1D' | '1W' | '1M' | 'YTD' | '1Y'
  twrPct     Float?
  flagged    Boolean  @default(false)
  flagReason String?
  isNew      Boolean  @default(false)
  computedAt DateTime @default(now())

  @@unique([userId, window])
  @@index([window, twrPct])
}

model PriceAlert {
  id                 String            @id @default(uuid())
  userId             String?
  ticker             String
  condition          String            // 'above' | 'below' | 'pct_up' | 'pct_down'
  targetPrice        Float?            // For above/below
  percentChange      Float?            // For pct_up/pct_down
  referencePrice     Float?            // Price when created (for % alerts)
  referencePriceType String?           // 'current' | 'open' | 'avgCost'
  repeatAlert        Boolean           @default(false)
  expiresAt          DateTime?
  enabled            Boolean           @default(true)
  triggered          Boolean           @default(false)
  triggeredAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  events             PriceAlertEvent[]

  @@index([ticker])
  @@index([enabled, triggered])
}

model PriceAlertEvent {
  id           String     @id @default(uuid())
  priceAlertId String
  priceAlert   PriceAlert @relation(fields: [priceAlertId], references: [id], onDelete: Cascade)
  triggerPrice Float
  message      String
  read         Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([priceAlertId])
}

// Analyst price target and rating tracking
model AnalystSnapshot {
  id              String   @id @default(uuid())
  ticker          String   @unique
  targetHigh      Float?
  targetLow       Float?
  targetMean      Float?
  targetMedian    Float?
  strongBuy       Int?
  buy             Int?
  hold            Int?
  sell            Int?
  strongSell      Int?
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([ticker])
}

model AnalystEvent {
  id          String   @id @default(uuid())
  ticker      String
  eventType   String   // 'target_change' | 'rating_change'
  message     String
  oldValue    String?  // JSON string of old data
  newValue    String?  // JSON string of new data
  changePct   Float?   // For target changes
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([ticker])
  @@index([read])
  @@index([createdAt])
}

// Alpha Vantage fundamentals cache — one row per ticker, stores parsed JSON
model FundamentalsCache {
  id              String   @id @default(uuid())
  ticker          String   @unique
  overviewJson    String?
  incomeJson      String?
  balanceJson     String?
  cashFlowJson    String?
  earningsJson    String?
  lastFetchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ticker])
  @@index([lastFetchedAt])
}

// Economic indicator cache — one row per indicator type
model EconomicIndicatorCache {
  id              String   @id @default(uuid())
  indicator       String   @unique
  name            String
  unit            String
  latestValue     Float?
  latestDate      String?
  historyJson     String   @default("[]")
  lastFetchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([indicator])
}

// Track Alpha Vantage daily API usage for budget management
model AVDailyUsage {
  id          String   @id @default(uuid())
  date        String   @unique
  callCount   Int      @default(0)
  tickers     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Milestone events for 52-week and all-time high/low alerts
model MilestoneEvent {
  id            String   @id @default(uuid())
  userId        String
  ticker        String
  eventType     String   // '52w_high' | '52w_low' | 'ath' | 'atl'
  message       String
  currentPrice  Float
  thresholdPrice Float   // The 52w high/low or ATH/ATL price
  isNewRecord   Boolean  @default(false) // True if it's a NEW high/low, not just at the level
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([ticker])
  @@index([read])
  @@index([createdAt])
}
