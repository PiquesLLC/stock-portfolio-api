generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Holding {
  id          String   @id @default(uuid())
  ticker      String   @unique
  shares      Float
  averageCost Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioSnapshot {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  totalValue     Float
  cashBalance    Float
  dailyPL        Float
  dailyPLPercent Float
  totalPL        Float
  totalPLPercent Float

  @@index([timestamp])
}

model Settings {
  id          String   @id @default("default")
  cashBalance Float    @default(0)
  marginDebt  Float    @default(0)
  updatedAt   DateTime @updatedAt

  // Baseline tracking for performance measurement
  trackingStartDate   DateTime?
  baselineTotalValue  Float?
  baselineCashBalance Float?
  baselineType        String?   // 'fresh_start' | 'existing_portfolio'

  // Optional broker lifetime stats (user-provided, display-only)
  brokerLifetimeDeposits    Float?
  brokerLifetimeWithdrawals Float?
  brokerLifetimeValue       Float?
  brokerLifetimeAsOf        DateTime?
}

model DividendEvent {
  id        String   @id @default(uuid())
  ticker    String
  amount    Float
  date      DateTime
  createdAt DateTime @default(now())

  @@index([date])
  @@index([ticker])
}

model Goal {
  id                  String    @id @default(uuid())
  name                String
  targetValue         Float
  monthlyContribution Float     @default(0)
  deadline            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
