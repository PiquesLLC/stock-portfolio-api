model CongressTrade {
  id                   String      @id @default(uuid())
  politician           String
  chamber              String   // Senate, House
  ticker               String
  transactionType      String   // Purchase, Sale, Sale (Partial), Exchange
  amountFrom           Float
  amountTo             Float
  tradeDate            DateTime
  filingDate           DateTime
  assetName            String?
  ownerType            String?  // Self, Spouse, Joint, Child, etc.
  source               String   @default("finnhub") // finnhub, quiverquant
  fetchedAt            DateTime @default(now())
  // Resolved Bioguide ID (e.g. W000805 for Mark Warner). Set by the
  // politician resolver during ingestion; null when no match was found.
  // Drives the clickable Capitol Trades / Congress.gov link in the UI.
  politicianBioguideId String?
  resolvedPolitician   Politician? @relation(fields: [politicianBioguideId], references: [bioguideId])

  @@unique([politician, ticker, tradeDate, transactionType])
  @@index([ticker])
  @@index([tradeDate])
  @@index([fetchedAt])
  @@index([politicianBioguideId])
}

// Canonical roster of US Congress members, keyed by Bioguide ID. Seeded /
// refreshed weekly from `unitedstates/congress-legislators` (the open community
// dataset that powers GovTrack, ProPublica, Capitol Trades, etc.). Used to
// resolve free-form FMP politician strings (e.g. "Mark Warner") to a stable ID
// so we can deep-link CongressTrade notifications to the official member page.
model Politician {
  bioguideId    String   @id
  canonicalName String   @unique
  firstName     String?
  lastName      String?
  chamber       String?  // "Senate" or "House"
  party         String?  // "Democrat", "Republican", "Independent"
  state         String?  // 2-letter postal code
  // JSON array of alias strings (nicknames, alt spellings) for fuzzy match.
  nameAliases   String   @default("[]")
  refreshedAt   DateTime @default(now())
  trades        CongressTrade[]

  @@index([lastName])
}

// ─── Verified Performance Profiles (Phase 2) ─────────────────────────

model PerformanceBadge {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     String    // top_10_pct | consistent_alpha | low_volatility | high_win_rate | diamond_hands | diversified
  window    String    // 1M | 3M | 6M | 1Y | ALL
  earnedAt  DateTime  @default(now())
  expiresAt DateTime?

  @@unique([userId, badge, window])
  @@index([userId])
}

model ProfileStatsCache {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  winRate      Float?
  totalTrades  Int?
  avgHoldDays  Float?
  profitFactor Float?
  computedAt   DateTime @default(now())

  @@index([userId])
}

// ─── Social Engagement Layer (Phase 3) ───────────────────────────────

model Post {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         String    // max 1000 chars (app-enforced)
  ticker          String?   // optional ticker reference
  type            String    @default("thought") // thought | analysis | trade_idea
  attachmentType  String?   // stock_chart | portfolio_chart | trade
  attachmentData  String?   // JSON: { ticker, period } | { period } | { ticker, action, shares, price }
  deleted         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  comments        Comment[]
  likes           Like[]

  @@index([userId, createdAt])
  @@index([ticker, createdAt])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   // max 500 chars
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model SocialNotification {
  id        String   @id @default(uuid())
  userId    String   // recipient
  user      User     @relation("socialNotifRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation("socialNotifActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      String   // new_follower | comment | like | mention
  postId    String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

// ─── Billionaire Net Worth Tracker ───────────────────────────

model Billionaire {
  id                String    @id @default(uuid())
  name              String    @unique
  slug              String    @unique
  photoUrl          String?
  company           String
  title             String?
  country           String    @default("US")
  industry          String?

  // Net worth computation
  baseNetWorthUsd   Float     // Non-public wealth (private companies, real estate, etc.) in USD
  holdings          String    // JSON: [{ "ticker": "TSLA", "shares": 411000000, "note": "..." }]

  // Cached computed values (refreshed with quotes)
  computedNetWorth  Float?
  dayChange         Float?
  dayChangePct      Float?
  weekChange        Float?
  monthChange       Float?
  ytdChange         Float?
  computedAt        DateTime?

  // Rank tracking
  rank              Int?
  previousRank      Int?

  // Metadata
  source            String    @default("manual") // manual | sec_13f | forbes
  lastVerifiedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  snapshots         BillionaireSnapshot[]

  @@index([rank])
  @@index([computedNetWorth])
}

model BillionaireSnapshot {
  id              String      @id @default(uuid())
  billionaireId   String
  billionaire     Billionaire @relation(fields: [billionaireId], references: [id], onDelete: Cascade)
  netWorth        Float
  timestamp       DateTime    @default(now())

  @@index([billionaireId, timestamp])
}

model WealthDistribution {
  id              String   @id @default(uuid())
  percentile      String   // "top_0.1" | "top_1" | "top_10" | "bottom_50"
  netWorthUsd     Float    // in millions
  date            String   // "2025-Q3"
  source          String   @default("fred")
  createdAt       DateTime @default(now())

  @@unique([percentile, date])
}

// ─── Content Moderation Strikes ──────────────────────────────────────

model ContentStrike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String   // hate_speech | racial_slur | violent_threat | sexual_content | targeted_harassment | other
  details   String?  // Admin notes or the offending content snippet
  issuedBy  String   // Admin userId who issued the strike
  createdAt DateTime @default(now())
  appeal    Appeal?

  @@index([userId])
  @@index([createdAt])
}

// ─── Content Moderation Appeals ─────────────────────────────────────

model Appeal {
  id          String    @id @default(uuid())
  strikeId    String    @unique // one appeal per strike
  userId      String
  reason      String    // user's explanation (max 1000 chars)
  status      String    @default("pending") // pending | reviewing | upheld | overturned
  adminNotes  String?   // admin's resolution notes
  resolvedBy  String?   // admin userId who resolved
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  strike      ContentStrike @relation(fields: [strikeId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// ─── User Blocking ──────────────────────────────────────────────────
model UserBlock {
  id          String   @id @default(uuid())
  blockerId   String
  blockedId   String
  blocker     User     @relation("blockerBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("blockedBlocks", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ─── Monitoring Reports (from scheduled cloud agents) ────────────────
model MonitoringReport {
  id        String   @id @default(uuid())
  type      String   // health | briefing | security | dev-report
  status    String   // ok | warning | critical
  data      String   @default("{}") // JSON payload
  source    String   @default("scheduled-agent")
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}
