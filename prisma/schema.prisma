generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Holding {
  id          String   @id @default(uuid())
  ticker      String
  shares      Float
  averageCost Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  @@unique([userId, ticker])
}

model PortfolioSnapshot {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  totalValue     Float
  cashBalance    Float
  dailyPL        Float
  dailyPLPercent Float
  totalPL        Float
  totalPLPercent Float
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId, timestamp])
}

model User {
  id          String              @id @default(uuid())
  username    String              @unique
  displayName String
  createdAt   DateTime            @default(now())
  holdings    Holding[]
  snapshots   PortfolioSnapshot[]
  settings    UserSettings?
}

model UserSettings {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  cashBalance Float    @default(0)
  marginDebt  Float    @default(0)
  updatedAt   DateTime @updatedAt
}

model Settings {
  id          String   @id @default("default")
  cashBalance Float    @default(0)
  marginDebt  Float    @default(0)
  updatedAt   DateTime @updatedAt

  // Baseline tracking for performance measurement
  trackingStartDate   DateTime?
  baselineTotalValue  Float?
  baselineCashBalance Float?
  baselineType        String?   // 'fresh_start' | 'existing_portfolio'

  // Optional broker lifetime stats (user-provided, display-only)
  brokerLifetimeDeposits    Float?
  brokerLifetimeWithdrawals Float?
  brokerLifetimeValue       Float?
  brokerLifetimeAsOf        DateTime?

  // Optional YTD tracking (user-provided for True YTD calculation)
  ytdStartEquity      Float?    // Net equity on Jan 1
  ytdNetContributions  Float?    // Deposits - withdrawals since Jan 1
}

model DividendEvent {
  id        String   @id @default(uuid())
  ticker    String
  amount    Float
  date      DateTime
  createdAt DateTime @default(now())

  @@index([date])
  @@index([ticker])
}

model Goal {
  id                  String    @id @default(uuid())
  name                String
  targetValue         Float
  monthlyContribution Float     @default(0)
  deadline            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
