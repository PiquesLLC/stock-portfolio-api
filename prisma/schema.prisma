// ─── Portfolio Trade History (from CSV import) ──────────────────────

model PortfolioTrade {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  ticker       String
  type         String   // 'buy' | 'sell' | 'split' | 'transfer' | 'merger' | 'cancel'
  shares       Float
  price        Float    @default(0)
  rowIndex     Int      @default(0)   // Position in source CSV for deterministic ordering
  sourceFileId String?                // Which import batch this trade came from
  sourceBroker String?                // Canonical: 'robinhood' | 'schwab' | 'mapped' | 'plaid' | 'unknown'
  rawAction    String?                // Original action text from CSV (e.g. "Buy", "Reinvest Shares")
  createdAt    DateTime @default(now())

  @@index([userId, date])
}

// ─── Ledger Events (cash/non-trade account events) ──────────────────

model LedgerEvent {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventType     String          // CHECK enforced: DEPOSIT|WITHDRAWAL|CASH_DIVIDEND|DIV_REINVEST|INTEREST|FEE|MARGIN_BORROW|MARGIN_REPAY
  effectiveDate DateTime
  settleDate    DateTime?

  ticker        String?
  shares        Float?
  price         Float?

  amount        Float           // signed cash movement: +in, -out
  fees          Float           @default(0)

  rowIndex      Int             @default(0)
  sourceBroker  String?         // CHECK enforced: robinhood|schwab|mapped|plaid|unknown
  sourceFileId  String?
  rawAction     String?

  createdAt     DateTime        @default(now())

  @@index([userId, effectiveDate, rowIndex, createdAt, id])
  @@index([userId, eventType])
  @@index([sourceFileId])
}

// ─── NALA AI Deep Research ───────────────────────────────────────────

model DeepResearchJob {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Request
  ticker                String?
  prompt                String
  researchType          String    @default("stock") // stock | portfolio | sector | custom
  clientRequestId       String?   // Idempotency key from client to prevent duplicate submissions

  // Gemini interaction tracking
  geminiInteractionId   String?
  parentInteractionId   String?   // For follow-up jobs linked to a parent interaction

  // Status lifecycle: queued → submitted → in_progress → completed | failed | cancelled
  status                String    @default("queued")

  // Thinking summaries (SSE stream) — JSON array of { text, timestamp, index }
  thinkingSummaries     String?

  // Results — store both raw payload and parsed report for auditability
  resultJson            String?   // Parsed structured report JSON
  resultText            String?   // Fallback raw text if JSON parse fails
  rawResultPayload      String?   // Full raw model response for audit
  parseError            String?   // JSON parse error reason if extraction failed
  errorMessage          String?   // Error message if status = failed

  // Cost telemetry
  inputTokens           Int?
  outputTokens          Int?
  searchCalls           Int?
  costUsdEstimate       Float?
  modelUsed             String?

  // Polling / lease (single-worker safety)
  polledBy              String?   // Instance ID holding the lease
  leaseUntil            DateTime? // Lease expiry — other instances skip until expired
  pollCount             Int       @default(0)
  submittedAt           DateTime?
  completedAt           DateTime?

  // Soft archive — hides from default list but keeps the row + result data.
  // Different from `status === 'cancelled'` (which is a job lifecycle state).
  archived              Boolean   @default(false)
  archivedAt            DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status])
  @@index([userId, archived])
  @@unique([userId, clientRequestId])
}

